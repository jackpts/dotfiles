# theme = UltraDark
theme = Ayu
window-theme=ghostty

# font-family = "JetBrains Mono"
# font-family=Fira Code
font-family = "CaskaydiaCove Nerd Font Mono"
font-size = 14

background-opacity = 0.9
gtk-titlebar = false

# custom-shader = bloom.glsl

# Autostart herdr, the ghostty twin of kitty's `shell /usr/bin/tmux`.
# Absolute path so it does not depend on the session PATH; use
# `ghostty -e fish` when a bare shell is needed.
command = /home/jacky/.local/bin/herdr

# background = #1b191b
# foreground = #d6deeb
# selection-foreground = #d6deeb
# selection-background = #363b5e
# cursor-invert-fg-bg = true
confirm-close-surface = false
# shell-integration-features = no-cursor
#custom-shader = "shaders/worley.glsl"
custom-shader-animation = always
custom-shader = shaders/cursor_blaze_no_trail.glsl
custom-shader = shaders/cursor_smear.glsl

