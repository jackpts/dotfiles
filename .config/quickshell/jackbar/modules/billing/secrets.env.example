# Jackbar AI billing secrets — copy to secrets.env (gitignored) and fill in.
# Loader also fills any missing keys from $HOME/scripts/.env.
#
# OpenRouter
#   Regular key (sk-or-v1-…): https://openrouter.ai/settings/keys
#     GET /api/v1/key — today/week/month spend and optional per-key cap
#     GET /api/v1/credits — account wallet remaining (works with a regular key too)
#   Management key is optional (same Keys page → Management API keys) if you
#   want activity/token totals for completed UTC days.
OPENROUTER_API_KEY=
OPENROUTER_MGMT_KEY=

# OpenCode
#   Names we read:
#     OPENCODE_CONSOLE_KEY  — Console service account oc_sk_… with All permissions
#                            (usage + budgets). Inference-only keys return HTTP 403.
#     ZEN_API_KEY           — optional Zen inference key (sk-…), alias OPENCODE_API_KEY
#   Wallet remaining (~$ left) comes from Console GET /api/billing/status using the
#   signed-in Zen/Firefox cookie `__Host-console_session` (same idea as Cursor’s
#   local IDE session). Override with OPENCODE_CONSOLE_SESSION if needed.
OPENCODE_CONSOLE_KEY=
# OPENCODE_API_KEY=
# ZEN_API_KEY=
# OPENCODE_CONSOLE_SESSION=

# Cursor (optional)
#   Prefer the local IDE session in ~/.config/Cursor/User/globalStorage/state.vscdb
#   (GetCurrentPeriodUsage — same numbers as https://cursor.com/dashboard/spending).
#   If Cursor is closed and that token 401/403s, the plugin reuses the signed-in
#   Zen/Firefox/LibreWolf cookie WorkosCursorSessionToken on cursor.com.
#   Log into https://cursor.com/dashboard in that browser at least once.
#   Set CURSOR_API_KEY only to override the Bearer token. Optional
#   CURSOR_SESSION_COOKIE overrides the browser cookie value.
#   A Cursor Admin API key is not required for personal spending.
# CURSOR_API_KEY=
# CURSOR_SESSION_COOKIE=
