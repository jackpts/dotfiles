{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras (Free Tier)",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{env:CEREBRAS_API_KEY}",
        "timeout": 120000,
        "headerTimeout": 30000,
        "chunkTimeout": 15000
      },
      "models": {
        "gpt-oss-120b": {
          "name": "gpt-oss-120b (Cerebras)"
        },
        "zai-glm-4.7": {
          "name": "Z.AI GLM-4.7 (Cerebras Free Tier)"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "{env:LMSTUDIO_API_KEY}",
        "timeout": 120000
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["uvx", "mcp-docker-server"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "oauth": {},
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "oauth": {},
      "enabled": true
    },
    "axiom": {
      "type": "remote",
      "url": "https://mcp.axiom.co/mcp",
      "oauth": {},
      "enabled": true
    },
    "servers": {
      "fetch": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-fetch"
        ]
      }
    }
  }
}
